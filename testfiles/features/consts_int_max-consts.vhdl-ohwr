library ieee;
use ieee.std_logic_1164.all;

package bigaddr_consts_pkg is
  constant C_BIGADDR_SIZE_SLV : std_logic_vector(32-1 downto 0) := x"80000008";
  constant C_BIGADDR_BLK_ADDR_SLV : std_logic_vector(32-1 downto 0) := x"80000000";
  constant C_ADDR_MASK_BIGADDR_BLK_SLV : std_logic_vector(32-1 downto 0) := x"fffffff8";
  constant C_ADDR_FMASK_BIGADDR_BLK_SLV : std_logic_vector(32-1 downto 0) := x"fffffff8";
  constant C_BIGADDR_BLK_SIZE : Natural := 8;
  constant C_BIGADDR_BLK_REG0_ADDR_SLV : std_logic_vector(32-1 downto 0) := x"80000000";
  constant C_BIGADDR_BLK_REG1_ADDR_SLV : std_logic_vector(32-1 downto 0) := x"80000004";
end package bigaddr_consts_pkg;
